{
  "name": "rojbey-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/domain.test.ts",
    "test:e2e": "playwright test",
    "demo:setup": "node scripts/setup-demo.mjs",
    "format": "prettier --write src scripts tests playwright.config.ts",
    "test:production": "node scripts/test-production.mjs",
    "start:render": "next start --hostname 0.0.0.0 --port ${PORT:-10000}"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
