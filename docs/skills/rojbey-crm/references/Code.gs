/** ROJBEY CRM Phase 01 • Google Sheets-backed proof of concept.
 * Deploy as bound Apps Script Web App after importing the supplied workbook to Google Sheets.
 * Do not place access tokens in the HTML.
 */
const RB={CUSTOMERS:'العملاء',APPTS:'المواعيد',TASKS:'المتابعات',LOG:'سجل العمليات',ZONE:'Africa/Cairo'};
const CHEAD=['Customer ID','الاسم','رقم الهاتف','تاريخ الفرح (أصلي)','مكان السكن','مصدر العميلة','كود الفستان','الملاحظات','الموظفة','حالة العميلة','نوع الخدمة','موديل الفستان','تاريخ الإضافة','آخر تعديل'];
const AHEAD=['Appointment ID','Customer ID','اسم العميلة','التاريخ','الوقت','نوع الموعد','الموظفة','الحالة','الملاحظات','تاريخ الإنشاء'];
const THEAD=['Task ID','Customer ID','اسم العميلة','المهمة','الموظفة','تاريخ الاستحقاق','الحالة','تاريخ الإنشاء'];
function onOpen(){SpreadsheetApp.getUi().createMenu('ROJBEY CRM').addItem('تجهيز النظام','RB_setup').addItem('اختبار النظام','RB_health').addToUi()}
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('ROJBEY | Bridal CRM').addMetaTag('viewport','width=device-width,initial-scale=1')}
function sheet_(name,headers){const ss=SpreadsheetApp.getActiveSpreadsheet();let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);if(s.getLastRow()===0){s.getRange(1,1,1,headers.length).setValues([headers]);s.setFrozenRows(1);s.getRange(1,1,1,headers.length).setBackground('#16171C').setFontColor('#F7F3EA').setFontWeight('bold');s.setRightToLeft(true)}return s}
function RB_setup(){sheet_(RB.CUSTOMERS,CHEAD);sheet_(RB.APPTS,AHEAD);sheet_(RB.TASKS,THEAD);sheet_(RB.LOG,['التاريخ','العملية','المرجع','المستخدم']);return {ok:true}}
function RB_health(){RB_setup();return {ok:true,name:SpreadsheetApp.getActiveSpreadsheet().getName()}}
function str_(v,max=500){return String(v===null||v===undefined?'':v).trim().slice(0,max)}
function safe_(v,max){const s=str_(v,max);return /^[=+@\t\r]/.test(s)?"'"+s:s}
function all_(s,cols){const n=s.getLastRow();return n<2?[]:s.getRange(2,1,n-1,cols).getDisplayValues().filter(r=>r.some(Boolean))}
function log_(kind,id){sheet_(RB.LOG,['التاريخ','العملية','المرجع','المستخدم']).appendRow([new Date(),kind,id,Session.getActiveUser().getEmail()||'مستخدم'])}
function RB_getData(){RB_setup();const c=all_(sheet_(RB.CUSTOMERS,CHEAD),CHEAD.length);const a=all_(sheet_(RB.APPTS,AHEAD),AHEAD.length);const t=all_(sheet_(RB.TASKS,THEAD),THEAD.length);return {customers:c.slice(-2500).reverse().map(r=>({id:r[0],name:r[1],phone:r[2],wedding:r[3],city:r[4],source:r[5],dress:r[6],notes:r[7],staff:r[8],status:r[9],service:r[10],model:r[11]})),appointments:a.slice(-400).reverse().map(r=>({id:r[0],customerId:r[1],name:r[2],date:r[3],time:r[4],type:r[5],staff:r[6],status:r[7]})),tasks:t.slice(-500).reverse().map(r=>({id:r[0],customerId:r[1],name:r[2],title:r[3],staff:r[4],due:r[5],status:r[6]})),stats:{customers:c.length,appointments:a.length,tasks:t.filter(r=>r[6]!=='مكتملة').length}}}
function RB_addCustomer(p){if(!p||!str_(p.name))throw Error('اسم العميلة مطلوب');RB_setup();const lock=LockService.getDocumentLock();lock.waitLock(20000);try{const s=sheet_(RB.CUSTOMERS,CHEAD),phone=str_(p.phone,30).replace(/[^\d+]/g,'');if(phone){const rows=all_(s,CHEAD.length);const exists=rows.find(r=>str_(r[2]).replace(/[^\d+]/g,'')===phone);if(exists)throw Error('رقم الهاتف مسجل بالفعل: '+exists[0])}const id='RB-C-'+Utilities.getUuid().slice(0,8).toUpperCase();const now=new Date();s.appendRow([id,safe_(p.name,120),safe_(phone,30),safe_(p.wedding,60),safe_(p.city,90),safe_(p.source,50),safe_(p.dress,60),safe_(p.notes,1500),safe_(p.staff,60),'جديدة',safe_(p.service,30),safe_(p.model,30),now,now]);log_('إضافة عميلة',id);return {ok:true,id}}finally{lock.releaseLock()}}
function RB_addAppointment(p){if(!p||!str_(p.customerId)||!/^\d{4}-\d{2}-\d{2}$/.test(str_(p.date)))throw Error('اختاري عميلة وتاريخًا صحيحًا');RB_setup();const lock=LockService.getDocumentLock();lock.waitLock(20000);try{const customers=all_(sheet_(RB.CUSTOMERS,CHEAD),CHEAD.length);const customer=customers.find(r=>r[0]===p.customerId);if(!customer)throw Error('العميلة غير موجودة');const ss=sheet_(RB.APPTS,AHEAD);const appts=all_(ss,AHEAD.length);const time=str_(p.time,8),staff=str_(p.staff||customer[8],60);if(appts.some(r=>r[3]===p.date&&r[4]===time&&r[6]===staff&&r[7]!=='ملغي'))throw Error('الموظفة لديها موعد في نفس التوقيت');const id='RB-A-'+Utilities.getUuid().slice(0,8).toUpperCase();ss.appendRow([id,customer[0],customer[1],p.date,time,safe_(p.type||'زيارة',50),safe_(staff,60),'مؤكد',safe_(p.notes,400),new Date()]);log_('حجز موعد',id);return {ok:true,id}}finally{lock.releaseLock()}}
function RB_addFollowup(p){if(!p||!str_(p.customerId)||!str_(p.title))throw Error('اختاري عميلة واكتبي المهمة');RB_setup();const lock=LockService.getDocumentLock();lock.waitLock(20000);try{const c=all_(sheet_(RB.CUSTOMERS,CHEAD),CHEAD.length).find(r=>r[0]===p.customerId);if(!c)throw Error('العميلة غير موجودة');const id='RB-T-'+Utilities.getUuid().slice(0,8).toUpperCase();sheet_(RB.TASKS,THEAD).appendRow([id,c[0],c[1],safe_(p.title,200),safe_(p.staff||c[8],60),safe_(p.due,20),'جديدة',new Date()]);log_('إضافة متابعة',id);return {ok:true,id}}finally{lock.releaseLock()}}
function RB_completeTask(id){const lock=LockService.getDocumentLock();lock.waitLock(20000);try{const s=sheet_(RB.TASKS,THEAD),rows=all_(s,THEAD.length);const k=rows.findIndex(r=>r[0]===id);if(k<0)throw Error('المهمة غير موجودة');s.getRange(k+2,7).setValue('مكتملة');log_('إغلاق مهمة',id);return {ok:true}}finally{lock.releaseLock()}}
