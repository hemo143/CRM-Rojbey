# Development uses synthetic local data. Never import real clients into demo mode.
CRM_DATA_PROVIDER=local
# Set true ONLY for a demo with synthetic data; defaults true in development.
CRM_DEMO_MODE=true
# For password login, set CRM_DEMO_MODE=false and set all three securely:
CRM_SESSION_SECRET=
CRM_ADMIN_PASSWORD=
CRM_STAFF_PASSWORD=
# Local data persists in .data/crm.json. Single process only.
# Public origin when deployed behind an HTTPS reverse proxy, e.g. https://crm.example.com
CRM_APP_ORIGIN=
